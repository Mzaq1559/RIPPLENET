# Pooled Neon connection string for application queries.
DATABASE_URL="postgresql://USER:PASSWORD@EP-POOLER.REGION.aws.neon.tech/DB?sslmode=require"

# Direct Neon connection string for schema migrations and db push.
DIRECT_URL="postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/DB?sslmode=require"

# Server-side Groq API key for live relief-analysis agents.
GROQ_API_KEY=

# Optional Groq model override. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b
